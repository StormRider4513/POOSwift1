{
  "name": "Swift Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "swift --version",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "sswg.swift-lang",
        "vknabel.vscode-swift-development-environment"
      ]
    }
  }
}